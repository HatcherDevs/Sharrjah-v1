<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    Options -Indexes

    RewriteEngine On

    # ============================================
    # منع البوتات الخبيثة والسكرابرز
    # ============================================
    
    # منع البوتات الخبيثة المعروفة (بدون جوجل)
    RewriteCond %{HTTP_USER_AGENT} AhrefsBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} SemrushBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} MJ12bot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} DotBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} BLEXBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} YandexBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} BingBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Baiduspider [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} GPTBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ChatGPT-User [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ClaudeBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} CCBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} PerplexityBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Bytespider [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} PetalBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} anthropic-ai [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Sogou [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Exabot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} MegaIndex [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Majestic [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} SEOkicks [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} sistrix [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} BacklinkCrawler [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Screaming [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} spbot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Nutch [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} HTTrack [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} wget [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Python-urllib [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} python-requests [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} libwww-perl [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} nikto [NC]
    RewriteRule ^(.*)$ - [F,L]

    # منع الطلبات بدون User-Agent
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule ^(.*)$ - [F,L]

    # منع طرق HTTP المشبوهة
    RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK|DEBUG|CONNECT) [NC]
    RewriteRule ^(.*)$ - [F,L]

    # ============================================

    # Force HTTPS (LiteSpeed/Hostinger)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Force www to non-www (optional - remove if you want www)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]


    <Files .env>
        Order allow,deny
        Deny from all
    </Files>

    <FilesMatch "\.(env|json|lock|md|gitignore|gitattributes|yml|yaml|log|sh|bak|old|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Protect favicon from modification
    <Files "favicon.ico">
        Order allow,deny
        Allow from all
    </Files>

    RedirectMatch 403 ^/(vendor|storage|bootstrap)/
    RedirectMatch 403 /\..*$
    
    
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
