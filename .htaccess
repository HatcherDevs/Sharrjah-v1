<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    Options -Indexes

    RewriteEngine On

    # ============================================
    # منع البوتات الخبيثة والسكرابرز
    # ============================================
    
    # منع البوتات الخبيثة المعروفة
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|linkdexbot|Sogou|YandexBot|BingBot|Baiduspider|Exabot|ia_archiver|MegaIndex|Majestic|SEOkicks|meanpathbot|sistrix|BacklinkCrawler|Screaming|spbot|TurnitinBot|magpie|Nutch|AspiegelBot|ZoominfoBot|Dataprovider|MauiBot|ClaudeBot|anthropic-ai|GPTBot|ChatGPT-User|CCBot|Google-Extended|PerplexityBot|Bytespider|PetalBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (wget|curl|libwww|Python|perl|nikto|scan|HTTrack|clshttp|harvest|extract|grab|miner|fetch|parser|loader|postman|httpie) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|mediapartners) [NC]
    RewriteCond %{HTTP_USER_AGENT} !Googlebot [NC]
    RewriteCond %{HTTP_USER_AGENT} !Googlebot-Image [NC]
    RewriteCond %{HTTP_USER_AGENT} !Googlebot-News [NC]
    RewriteCond %{HTTP_USER_AGENT} !Googlebot-Video [NC]
    RewriteCond %{HTTP_USER_AGENT} !Google-InspectionTool [NC]
    RewriteCond %{HTTP_USER_AGENT} !AdsBot-Google [NC]
    RewriteRule .* - [F,L]

    # منع الطلبات بدون User-Agent
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} ^-$ 
    RewriteRule .* - [F,L]

    # منع طرق HTTP المشبوهة
    RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK|DEBUG|CONNECT) [NC]
    RewriteRule .* - [F,L]

    # منع محاولات حقن SQL في URL
    RewriteCond %{QUERY_STRING} (union|select|insert|drop|delete|update|alter|create|truncate|exec|execute|xp_|sp_|0x|cast|declare|nvarchar|varchar) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|;|'|"|<|>|\[|\]|\{|\}|\\x00|\\x1a) [NC]
    RewriteRule .* - [F,L]

    # Rate Limiting - منع الطلبات السريعة جداً (يحتاج mod_evasive)
    # <IfModule mod_evasive20.c>
    #     DOSHashTableSize 3097
    #     DOSPageCount 2
    #     DOSSiteCount 50
    #     DOSPageInterval 1
    #     DOSSiteInterval 1
    #     DOSBlockingPeriod 10
    # </IfModule>

    # ============================================

    # Force HTTPS (LiteSpeed/Hostinger)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Force www to non-www (optional - remove if you want www)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]


    <Files .env>
        Order allow,deny
        Deny from all
    </Files>

    <FilesMatch "\.(env|json|lock|md|gitignore|gitattributes|yml|yaml|log|sh|bak|old|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Prevent PHP execution in uploads and fonts directories
    <DirectoryMatch "^.*/uploads/">
        <FilesMatch "\.php$">
            Order allow,deny
            Deny from all
        </FilesMatch>
    </DirectoryMatch>
    
    <DirectoryMatch "^.*/fonts/">
        <FilesMatch "\.php$">
            Order allow,deny
            Deny from all
        </FilesMatch>
    </DirectoryMatch>
    
    # Protect favicon from modification
    <Files "favicon.ico">
        Order allow,deny
        Allow from all
    </Files>

    RedirectMatch 403 ^/(vendor|storage|bootstrap)/
    RedirectMatch 403 /\..*$
    
    
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
