# Force HTTPS (LiteSpeed/Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# OpenLiteSpeed LSCache Configuration

<IfModule Litespeed>
    CacheLookup on
    # Do not cache admin paths or POST requests
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^POST$
    RewriteRule .* - [E=Cache-Control:no-cache]
    RewriteCond %{REQUEST_URI} ^/admin [OR]
    RewriteCond %{REQUEST_URI} ^/login
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Security: Prevent PHP execution in uploads and fonts directories

<DirectoryMatch "^.\*/uploads/">
<FilesMatch "\.php$">
Order allow,deny
Deny from all
</FilesMatch>
</DirectoryMatch>

<DirectoryMatch "^.\*/fonts/">
<FilesMatch "\.php$">
Order allow,deny
Deny from all
</FilesMatch>
</DirectoryMatch>

# Protect favicon.ico

<Files "favicon.ico"> # Allow access but prevent modification via web
Header set Cache-Control "public, max-age=31536000, immutable"
</Files>

# Prevent access to hidden files

<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>
