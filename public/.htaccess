# Force HTTPS (LiteSpeed/Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# OpenLiteSpeed LSCache Configuration
# Disabled: OLS server-level cache prevents content updates from appearing.
# Laravel application-level cache (CacheResponse middleware) handles caching instead.

<IfModule Litespeed>
    CacheLookup off
</IfModule>

# Security: Prevent PHP execution in uploads and fonts directories

<DirectoryMatch "^.\*/uploads/">
<FilesMatch "\.php$">
Order allow,deny
Deny from all
</FilesMatch>
</DirectoryMatch>

<DirectoryMatch "^.\*/fonts/">
<FilesMatch "\.php$">
Order allow,deny
Deny from all
</FilesMatch>
</DirectoryMatch>

# Protect favicon.ico

<Files "favicon.ico"> # Allow access but prevent modification via web
Header set Cache-Control "public, max-age=31536000, immutable"
</Files>

# Prevent access to hidden files

<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>
